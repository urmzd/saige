{
  "$schema": "https://raw.githubusercontent.com/urmzd/saige/main/agent/provider/catalog/catalog.schema.json",
  "version": 1,
  "revision": "test.1",
  "inherit_default": false,
  "templates": {
    "anthropic.base": {
      "extends": "tool_use",
      "add_capabilities": [
        "temperature",
        "top_p",
        "top_k",
        "stop_sequences",
        "max_output_tokens",
        "prompt_caching",
        "prompt_cache_markers",
        "structured_output",
        "parallel_tool_control"
      ],
      "limits": {
        "context_window": 200000,
        "default_max_output_tokens": 4096
      },
      "structured_output": "tool_call",
      "media": [
        "image/jpeg",
        "image/png",
        "application/pdf"
      ]
    },
    "anthropic.thinking": {
      "extends": "anthropic.base",
      "add_capabilities": [
        "reasoning",
        "reasoning_budget",
        "reasoning_signature",
        "server_tools",
        "web_search"
      ],
      "reasoning": {
        "min_budget": 1024
      },
      "server_tools": [
        "web_search"
      ],
      "server_tool_fees": {
        "web_search": {
          "currency": "USD",
          "per_use": 0.01,
          "as_of": "2026-07-24",
          "source": "vendor list price"
        }
      }
    },
    "tool_use": {
      "capabilities": [
        "tools",
        "parallel_tools",
        "tool_choice",
        "streaming",
        "system_prompt"
      ]
    }
  },
  "models": [
    {
      "provider": "anthropic",
      "prefix": "claude-3-5-haiku",
      "extends": "anthropic.base",
      "tier": "economy",
      "limits": {
        "max_output_tokens": 8192
      },
      "pricing": {
        "currency": "USD",
        "input_per_mtok": 0.8,
        "output_per_mtok": 4,
        "as_of": "2026-07-24"
      }
    },
    {
      "provider": "anthropic",
      "prefix": "claude-sonnet-4-6",
      "extends": "anthropic.thinking",
      "tier": "standard",
      "add_capabilities": [
        "reasoning_effort"
      ],
      "reasoning": {
        "efforts": [
          "low",
          "medium",
          "high",
          "max"
        ]
      }
    },
    {
      "provider": "openai",
      "prefix": "gpt-4.1",
      "extends": "tool_use",
      "tier": "standard",
      "add_capabilities": [
        "temperature",
        "top_p",
        "stop_sequences",
        "max_output_tokens",
        "seed",
        "frequency_penalty",
        "presence_penalty",
        "prompt_caching",
        "automatic_prompt_cache",
        "parallel_tool_control",
        "structured_output"
      ],
      "limits": {
        "context_window": 1000000,
        "max_output_tokens": 32768
      },
      "structured_output": "native",
      "pricing": {
        "currency": "USD",
        "input_per_mtok": 2,
        "output_per_mtok": 8,
        "cached_input_per_mtok": 0.5,
        "as_of": "2026-07-24",
        "source": "vendor list price"
      },
      "defaults": {
        "max_output_tokens": 4096
      }
    }
  ],
  "baselines": {
    "openai": {
      "extends": "tool_use",
      "notes": [
        "unrecognised model"
      ]
    }
  },
  "presets": {
    "balanced": {
      "description": "General assistant with cross-vendor failover",
      "options": {
        "max_output_tokens": 8192,
        "stop": [
          "</answer>"
        ]
      },
      "tool_choice": "auto",
      "output_mode": "auto",
      "llm_timeout": "2m0s",
      "compaction": {
        "strategy": "chain",
        "max_input_tokens": 100000,
        "chain": [
          {
            "strategy": "clear_tool_results",
            "keep_tool_results": 3
          },
          {
            "strategy": "relevant_plus_summary",
            "keep_turns": 4,
            "select_k": 3,
            "summary_model": "claude-haiku-5-5"
          }
        ]
      },
      "retry": {
        "max_attempts": 3,
        "base_delay": "500ms",
        "max_delay": "10s"
      },
      "routing": {
        "policy": "affinity"
      },
      "chain": [
        {
          "id": "primary",
          "provider": "anthropic",
          "model": "claude-sonnet-4-6",
          "options": {
            "reasoning": {
              "effort": "medium"
            },
            "prompt_cache": {
              "mode": "markers",
              "ttl": "5m",
              "tools": true,
              "system": true
            }
          }
        },
        {
          "id": "openai",
          "provider": "openai",
          "model": "gpt-4.1",
          "options": {
            "temperature": 0.3,
            "seed": 7,
            "prompt_cache": {
              "mode": "automatic",
              "retention": "24h"
            }
          }
        }
      ]
    },
    "deterministic-extract": {
      "options": {
        "temperature": 0,
        "seed": 42,
        "max_output_tokens": 2048
      },
      "output_mode": "tool",
      "require_declared": false,
      "chain": [
        {
          "provider": "openai",
          "model": "gpt-4.1"
        },
        {
          "provider": "anthropic",
          "model": "claude-3-5-haiku",
          "unset": [
            "seed"
          ]
        }
      ]
    },
    "deterministic-extract-strict": {
      "extends": "deterministic-extract",
      "require_declared": true
    }
  },
  "default_preset": "balanced"
}
