{
  "$schema": "https://raw.githubusercontent.com/urmzd/saige/main/agent/provider/catalog/catalog.schema.json",
  "version": 2,
  "revision": "test.1",
  "inherit_default": false,
  "model_templates": {
    "anthropic.base": {
      "limits": {
        "context_window": 200000
      },
      "modalities": {
        "in": [
          "text",
          "image",
          "document"
        ]
      }
    }
  },
  "models": {
    "anthropic/claude-3-5-haiku": {
      "extends": "anthropic.base",
      "tier": "economy",
      "limits": {
        "max_output_tokens": 8192
      }
    },
    "anthropic/claude-sonnet-4-6": {
      "extends": "anthropic.base",
      "tier": "standard"
    },
    "openai/gpt-4.1": {
      "tier": "standard",
      "limits": {
        "context_window": 1000000,
        "max_output_tokens": 32768
      }
    }
  },
  "endpoints": {
    "anthropic": {
      "surface": "anthropic.messages",
      "serves": [
        "anthropic"
      ],
      "primary": true,
      "auth": {
        "type": "api_key",
        "secret": "env:ANTHROPIC_API_KEY"
      },
      "files": {
        "api": true,
        "uri_schemes": [
          "https"
        ]
      },
      "modes": {
        "batch": true
      }
    },
    "openai-chat": {
      "surface": "openai.chat",
      "serves": [
        "openai"
      ],
      "primary": true,
      "auth": {
        "type": "api_key",
        "secret": "env:OPENAI_API_KEY"
      },
      "files": {
        "api": true,
        "uri_schemes": [
          "https"
        ]
      },
      "modes": {
        "batch": true
      },
      "default_offering_template": "baseline.openai"
    },
    "openai-responses": {
      "surface": "openai.responses",
      "serves": [
        "openai"
      ],
      "auth": {
        "type": "api_key",
        "secret": "env:OPENAI_API_KEY"
      },
      "files": {
        "api": true,
        "uri_schemes": [
          "https"
        ]
      },
      "modes": {
        "batch": true
      },
      "default_offering_template": "baseline.openai",
      "inherit_offerings": "openai-chat"
    }
  },
  "offering_templates": {
    "anthropic.base": {
      "extends": "tool_use",
      "add_features": [
        "prompt_caching",
        "prompt_cache_markers",
        "structured_output"
      ],
      "params": {
        "max_output_tokens": {
          "default": 4096,
          "allowed": true
        },
        "parallel_tools": {
          "allowed": true
        },
        "stop": {
          "allowed": true
        },
        "temperature": {
          "allowed": true
        },
        "top_k": {
          "allowed": true
        },
        "top_p": {
          "allowed": true
        }
      },
      "modalities": {
        "in": {
          "audio": null,
          "document": {
            "media": [
              "application/pdf"
            ]
          },
          "file": null,
          "image": {
            "media": [
              "image/jpeg",
              "image/png"
            ]
          },
          "video": null
        }
      },
      "structured_output": "tool_call"
    },
    "anthropic.thinking": {
      "extends": "anthropic.base",
      "add_features": [
        "reasoning",
        "reasoning_signature",
        "server_tools",
        "web_search"
      ],
      "params": {
        "reasoning.budget": {
          "min": 1024,
          "allowed": true
        }
      },
      "server_tools": [
        "web_search"
      ],
      "server_tool_fees": {
        "web_search": {
          "currency": "USD",
          "per_use": 0.01,
          "as_of": "2026-07-24",
          "source": "vendor list price"
        }
      }
    },
    "baseline.openai": {
      "extends": "tool_use",
      "notes": [
        "unrecognised model"
      ]
    },
    "tool_use": {
      "features": [
        "tools",
        "parallel_tools",
        "streaming",
        "system_prompt"
      ],
      "params": {
        "frequency_penalty": {
          "allowed": false
        },
        "max_output_tokens": {
          "allowed": false
        },
        "parallel_tools": {
          "allowed": false
        },
        "presence_penalty": {
          "allowed": false
        },
        "reasoning.budget": {
          "allowed": false
        },
        "reasoning.effort": {
          "allowed": false
        },
        "reasoning.enabled": {
          "allowed": false
        },
        "seed": {
          "allowed": false
        },
        "stop": {
          "allowed": false
        },
        "temperature": {
          "allowed": false
        },
        "tool_choice": {
          "allowed": true
        },
        "top_k": {
          "allowed": false
        },
        "top_p": {
          "allowed": false
        }
      }
    }
  },
  "offerings": [
    {
      "model": "anthropic/claude-3-5-haiku",
      "endpoint": "anthropic",
      "extends": "anthropic.base",
      "pricing": {
        "currency": "USD",
        "input_per_mtok": 0.8,
        "output_per_mtok": 4,
        "as_of": "2026-07-24"
      }
    },
    {
      "model": "anthropic/claude-sonnet-4-6",
      "endpoint": "anthropic",
      "extends": "anthropic.thinking",
      "params": {
        "reasoning.effort": {
          "values": [
            "low",
            "medium",
            "high",
            "max"
          ],
          "allowed": true
        }
      }
    },
    {
      "model": "openai/gpt-4.1",
      "endpoint": "openai-chat",
      "extends": "tool_use",
      "add_features": [
        "prompt_caching",
        "automatic_prompt_cache",
        "structured_output"
      ],
      "params": {
        "frequency_penalty": {
          "allowed": true
        },
        "max_output_tokens": {
          "allowed": true
        },
        "parallel_tools": {
          "allowed": true
        },
        "presence_penalty": {
          "allowed": true
        },
        "seed": {
          "allowed": true
        },
        "stop": {
          "allowed": true
        },
        "temperature": {
          "allowed": true
        },
        "top_p": {
          "allowed": true
        }
      },
      "structured_output": "native",
      "pricing": {
        "currency": "USD",
        "input_per_mtok": 2,
        "output_per_mtok": 8,
        "cached_input_per_mtok": 0.5,
        "as_of": "2026-07-24",
        "source": "vendor list price"
      },
      "defaults": {
        "max_output_tokens": 4096
      }
    }
  ],
  "presets": {
    "balanced": {
      "description": "General assistant with cross-vendor failover",
      "options": {
        "max_output_tokens": 8192,
        "stop": [
          "</answer>"
        ]
      },
      "tool_choice": "auto",
      "output_mode": "auto",
      "llm_timeout": "2m0s",
      "compaction": {
        "strategy": "chain",
        "max_input_tokens": 100000,
        "chain": [
          {
            "strategy": "clear_tool_results",
            "keep_tool_results": 3
          },
          {
            "strategy": "relevant_plus_summary",
            "keep_turns": 4,
            "select_k": 3,
            "summary_model": "claude-haiku-5-5"
          }
        ]
      },
      "retry": {
        "max_attempts": 3,
        "base_delay": "500ms",
        "max_delay": "10s"
      },
      "routing": {
        "policy": "affinity"
      },
      "chain": [
        {
          "id": "primary",
          "provider": "anthropic",
          "model": "claude-sonnet-4-6",
          "options": {
            "reasoning": {
              "effort": "medium"
            },
            "prompt_cache": {
              "mode": "markers",
              "ttl": "5m",
              "tools": true,
              "system": true
            }
          }
        },
        {
          "id": "openai",
          "provider": "openai",
          "model": "gpt-4.1",
          "options": {
            "temperature": 0.3,
            "seed": 7,
            "prompt_cache": {
              "mode": "automatic",
              "retention": "24h"
            }
          }
        }
      ]
    },
    "deterministic-extract": {
      "options": {
        "temperature": 0,
        "seed": 42,
        "max_output_tokens": 2048
      },
      "output_mode": "tool",
      "require_declared": false,
      "chain": [
        {
          "provider": "openai",
          "model": "gpt-4.1"
        },
        {
          "provider": "anthropic",
          "model": "claude-3-5-haiku",
          "unset": [
            "seed"
          ]
        }
      ]
    },
    "deterministic-extract-strict": {
      "extends": "deterministic-extract",
      "require_declared": true
    }
  },
  "default_preset": "balanced"
}
